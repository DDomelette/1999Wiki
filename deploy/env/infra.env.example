# Validation-only placeholders. Copy this file outside Git and replace every
# replace-before-production value before starting production infrastructure.
MYSQL_ROOT_PASSWORD=replace-before-production
MYSQL_USER=replace-before-production
MYSQL_PASSWORD=replace-before-production
MINIO_ROOT_USER=replace-before-production
MINIO_ROOT_PASSWORD=replace-before-production

# MinIO's API is loopback-only so host Caddy can publish /media safely.
MINIO_HOST_PORT=19000
ATTU_HOST_PORT=13001
