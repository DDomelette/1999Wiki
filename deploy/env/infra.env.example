# This checked-in example is intentionally non-runnable. Copy it outside Git,
# run chmod 600 on the copy, then fill every credential before production.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# MinIO's API is loopback-only so host Caddy can publish /media safely.
MINIO_HOST_PORT=19000
ATTU_HOST_PORT=13001
