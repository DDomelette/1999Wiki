# 复制本文件为 .env 并填入你的 API Key
# DeepSeek: https://platform.deepseek.com/
# SiliconFlow: https://cloud.siliconflow.cn/account/ak
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# Independent model used only by the full-chain evaluator.
RAG_EVAL_JUDGE_BASE_URL=
RAG_EVAL_JUDGE_MODEL=
RAG_EVAL_JUDGE_API_KEY=

# MinIO used by shared RAG media and Wiki media.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Project-local Huiji crawler credential file. Keep the real file out of source packages.
HUIJI_CONFIG_PATH=.local/huiji/credentials/config.dat

# Wiki MySQL. Dev migration target uses 3307 to avoid edurag-mysql on 3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=reverse1999_wiki
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456
