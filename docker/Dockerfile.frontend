FROM node:22.23.1-alpine AS build

WORKDIR /app
COPY frontend/react-app/package.json frontend/react-app/package-lock.json ./
RUN npm ci
COPY frontend/react-app/index.html frontend/react-app/tsconfig.json \
     frontend/react-app/tsconfig.node.json frontend/react-app/vite.config.ts ./
COPY frontend/react-app/src ./src
COPY frontend/react-app/public ./public
RUN npm run build

FROM caddy:2.11.4-alpine

RUN addgroup -S caddy && adduser -S -D -H -G caddy caddy \
    && chown -R caddy:caddy /config /data
COPY --from=build /app/dist /srv
COPY docker/frontend.Caddyfile /etc/caddy/Caddyfile

USER caddy
EXPOSE 8080
